      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Recuperação de senha",
        "description": "Rota utilizada para recuperação de senhas através do e-mail do usuário. Receba um e-mail para recuperação de senha.",
        "responses": {
          "200": {
            "description": "Token do usuário autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "204": {
            "description": "No Content"
          }
        },
        "requestBody": {}
      }
    },
