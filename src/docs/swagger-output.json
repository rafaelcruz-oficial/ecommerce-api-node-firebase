    "schemas": {
      "addUser": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string",
            "example": "João da Silva"
          },
          "email": {
            "type": "string",
            "example": "joaodasilva@mail.com"
          },
          "password": {
