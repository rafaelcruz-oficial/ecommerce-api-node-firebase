      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "2mkre4j5gPo0BFGl5pyi"
          },
          "nome": {
            "type": "string",
            "example": "João da Silva"
          },
          "email": {
            "type": "string",
            "example": "joaodasilva@mail.com"
          }
        }
      },
      "addOrder": {
        "type": "object",
        "properties": {
          "empresa": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "example": "1SBiiMrf4JUUFG57M76F"
              }
            },
            "required": [
              "id"
            ]
          },
          "cliente": {
            "type": "object",
            "properties": {
              "nome": {
                "type": "string",
                "example": "João da Silva"
              },
              "telefone": {
                "type": "string",
                "example": "1199999999"
              }
            },
            "required": [
              "nome",
              "telefone"
            ]
          },
          "endreco": {
            "type": "object",
            "properties": {
              "cep": {
                "type": "string",
                "example": "7590000"
              },
              "logradouro": {
                "type": "string",
                "example": "Rua Brandura"
              },
              "numero": {
                "type": "string",
                "example": "11"
              },
              "bairro": {
                "type": "string",
                "example": "Setor XPTO"
              },
              "complemento": {
                "type": "string",
                "example": "402"
              },
              "cidade": {
                "type": "string",
                "example": "Não-me-toque"
              },
              "uf": {
                "type": "string",
                "example": "RS"
              }
            },
            "required": [
              "logradouro",
              "numero",
              "bairro",
              "complemento",
              "cidade",
              "uf"
            ]
          },
          "cpfCnpjCupom": {},
          "isEntrega": {
            "type": "boolean",
            "example": true
          },
          "formaPagamento": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "example": "NdmCoyl01T3gHwhO0pyQ"
              }
            },
            "required": [
              "id"
            ]
          },
          "taxaEntrega": {
            "type": "number",
            "example": 100
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "produto": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "example": "3UfzI8CSCak5eC0UJJ8gI"
                    }
                  },
                  "required": [
                    "id"
                  ]
                },
                "qtde": {
                  "type": "number",
                  "example": 1
                },
                "observacoes": {}
              },
              "required": [
                "produto",
                "qtde"
              ]
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "pendente",
              null
            ]
          },
          "observacoes": {}
        },
        "required": [
          "empresa",
          "cliente",
          "isEntrega",
          "formaPagamento",
          "taxaEntrega",
          "items"
        ]
      },
      "updateOrderStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "aprovado",
              "entrega",
              "concluido",
              "cancelado",
              null
            ]
          }
        },
        "required": [
          "status"
        ]
      }
    },
    "parameters": {
      "empresaId": {
        "name": "empresaId",
        "in": "query",
        "description": "Id da empresa",
        "schema": {
          "type": "string"
        }
      },
      "dataInicio": {
        "name": "dataInico",
        "in": "query",
        "description": "Data de inicio do filtro no formato YYYY-MM-DD",
        "schema": {
          "type": "date"
        }
      },
      "dataFim": {
        "name": "dataFim",
        "in": "query",
        "description": "Data de fim do filtro no formato YYYY-MM-DD",
        "schema": {
          "type": "date"
        }
      },
      "orderStatus": {
        "name": "status",
        "in": "query",
        "description": "Status do pedido.",
        "schema": {
          "type": "string",
          "enum": [
            "pendente",
            "aprovado",
            "entrega",
            "concluido",
            "cancelado"
          ]
        }
      }
    }
